{
  "name": "one-more-run",
  "private": true,
  "version": "0.1.0",
  "description": "One More Run - a greedy roguelike dungeon crawler on Ronin",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:game": "npm run dev --workspace=@omr/game",
    "dev:server": "npm run dev --workspace=@omr/server",
